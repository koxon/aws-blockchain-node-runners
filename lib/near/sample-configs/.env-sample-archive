#############################################################
# Example configuration for Near nodes runner app on AWS  #
#############################################################

## Set the AWS account is and region for your environment ##
AWS_ACCOUNT_ID="xxxxxxxxxxxx"
AWS_REGION="us-east-1"

## Common configuration parameters ##
NEAR_CLUSTER="mainnet-beta"                 # All options:  "mainnet-beta", "testnet", "devnet"
NEAR_NODE_CONFIGURATION="archive"                   # All options:   "validator", "rpc", "archive"
NEAR_VERSION="1.17.22"                       # Latest required version of Near. Check for latest Mainnet version https://github.com/near-labs/near/releases

NEAR_INSTANCE_TYPE="x2idn.16xlarge"
NEAR_CPU_TYPE="x86_64"                      # All options: "x86_64", "ARM_64". IMPORTANT: Make sure the CPU type matches the instance type used
# Data volume configuration
NEAR_DATA_VOL_TYPE="gp3"                    # Other options: "io1" | "io2" | "gp3" | "instance-store" . IMPORTANT: Use "instance-store" option only with instance types that support that feature, like popular for node im4gn, d3, i3en, and i4i instance families
NEAR_DATA_VOL_SIZE="2000"                   # Current required data size to keep both smapshot archive and unarchived version of it
NEAR_DATA_VOL_IOPS="12000"                  # Max IOPS for EBS volumes (not applicable for "instance-store")
NEAR_DATA_VOL_THROUGHPUT="700"              # Max throughput for EBS gp3 volumes (not applicable for "io1" | "io2" | "instance-store")
# Accounts volume configuration
NEAR_ACCOUNTS_VOL_TYPE="instance-store"     # Other options: "io1" | "io2" | "gp3" | "instance-store" . IMPORTANT: Use "instance-store" option only with instance types that support that feature, like popular for node im4gn, d3, i3en, and i4i instance families
NEAR_ACCOUNTS_VOL_SIZE="0"                  # Current required data size to keep both smapshot archive and unarchived version of it
NEAR_ACCOUNTS_VOL_IOPS="0"                  # Max IOPS for EBS volumes (not applicable for "instance-store")
NEAR_ACCOUNTS_VOL_THROUGHPUT="0"            # Max throughput for EBS gp3 volumes (not applicable for "io1" | "io2" | "instance-store")
# Secrets configuration
NEAR_NODE_IDENTITY_SECRET_ARN="none"                            # Optional. The ARN of the secret in AWS Secrets Manager with the node identity key pair. In case you want to provision a node but keep the old identity.

## HA nodes configuration ##
NEAR_HA_NUMBER_OF_NODES="2"                     # Total number of RPC nodes to be provisioned. Default: 2
NEAR_HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="70"   # Time enough to initialize the instance
NEAR_HA_NODES_HEARTBEAT_DELAY_MIN="10"          # Time sufficient enough for a node do sync
